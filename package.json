{
  "name": "literabit-v2",
  "version": "0.1.0",
  "private": true,
  "description": "Literabit - Web-Based Reading Comprehension Platform for Children",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "type-check": "tsc --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "fmt": "oxfmt --check .",
    "fmt:fix": "oxfmt .",
    "test": "bun test ./src ./test/unit",
    "test:integration": "bun run db:test:prepare && cross-env RUN_INTEGRATION_TESTS=1 bun test --parallel=1 ./test/integration",
    "db:generate": "bun --env-file=.env drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "bun --env-file=.env src/db/migrate.ts",
    "db:seed": "bun --env-file=.env src/db/seed.ts",
    "db:studio": "bun --env-file=.env drizzle-kit studio --config drizzle.config.ts --host 127.0.0.1",
    "db:test:prepare": "bun ./infra/local/prepare-test-db.ts",
    "infra:up": "docker compose -f infra/local/docker-compose.yml up -d --wait && bun run db:test:prepare",
    "infra:down": "docker compose -f infra/local/docker-compose.yml down",
    "complete-check": "bun run type-check && bun run lint && bun run fmt && bun run test && bun run build",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "drizzle-orm": "^0.45.1",
    "jose": "^6.1.0",
    "lucide-react": "^0.511.0",
    "next": "16.4.6",
    "postgres": "^3.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "4.23.0",
    "tw-animate-css": "1.4.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/bun": "^1.3.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.0.0",
    "drizzle-kit": "^0.31.10",
    "husky": "^9.1.7",
    "lint-staged": "^16.0.0",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.63.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,mts}": [
      "oxfmt",
      "oxlint --fix"
    ],
    "*.{json,md,css,html,yaml,yml,toml}": [
      "oxfmt"
    ]
  }
}
