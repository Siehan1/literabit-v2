# Copy to .env for local development. Values below are local-only placeholders.

APP_ENV=development
APP_VERSION=0.1.0

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (PostgreSQL via Docker Compose in infra/local/docker-compose.yml)
DATABASE_URL=postgres://literabit:local-postgres-password@localhost:5433/literabit
TEST_DATABASE_URL=postgres://literabit:local-postgres-password@localhost:5433/literabit_test

# Authentication & Signed Cookies (minimum 32 characters for production/dev signing)
AUTH_SECRET=replace-with-local-random-secret-at-least-32-chars
